{
  "name": "finvision",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,green \"npm run dev --workspace finvision-server\" \"npm run dev --workspace finvision-client\"",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspace finvision-server",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.4.2"
  },
  "dependencies": {
    "@google/genai": "^1.47.0"
  }
}
