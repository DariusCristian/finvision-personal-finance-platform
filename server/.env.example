PORT=5001
NODE_ENV=development
# MongoDB must be a replica set (the server uses transactions and exits at startup on a standalone).
# Local: run `docker compose up -d mongo` from the repo root. MongoDB Atlas clusters work as they are.
MONGODB_URI=mongodb://localhost:27017/finvision?replicaSet=rs0&directConnection=true
CORS_ORIGINS=http://localhost:5173
# JWT secrets: at least 32 characters, different from each other. Generate each with:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
MARKETAUX_API_KEY=your_marketaux_api_key
FINNHUB_API_KEY=your_finnhub_api_key
COINGECKO_API_KEY=your_coingecko_api_key

# Reverse proxies in front of the server (e.g. 1 behind nginx/a PaaS router). Keep false when clients connect
# directly: trusting X-Forwarded-For without a proxy would let clients pick their own IP for rate limiting.
TRUST_PROXY=false
# Rate limits (per client IP; Finny chat per user). Defaults shown; RATE_LIMIT_ENABLED=false disables them.
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000
REGISTER_RATE_LIMIT_MAX=10
REGISTER_RATE_LIMIT_WINDOW_MS=3600000
REFRESH_RATE_LIMIT_MAX=60
REFRESH_RATE_LIMIT_WINDOW_MS=900000
FINNY_CHAT_RATE_LIMIT_MAX=20
FINNY_CHAT_RATE_LIMIT_WINDOW_MS=60000
